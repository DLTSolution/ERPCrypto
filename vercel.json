{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    },
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "server/**",
        "shared/**"
      ]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "buildCommand": "npm run build"
}
